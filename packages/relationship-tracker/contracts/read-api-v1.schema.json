{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pasta-Devs/Marinara-Agents/relationship-tracker/contracts/read-api-v1.schema.json",
  "title": "Relationship Tracker read API v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chatId",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chatId": {
      "type": "string",
      "minLength": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definedRelationship"
      }
    }
  },
  "$defs": {
    "definedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterAId",
        "characterBId",
        "label",
        "description",
        "colorCategory",
        "manuallyLocked"
      ],
      "properties": {
        "characterAId": {
          "type": "string",
          "minLength": 1
        },
        "characterBId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "colorCategory": {
          "enum": [
            "positive",
            "neutral",
            "negative",
            "complicated"
          ]
        },
        "manuallyLocked": {
          "type": "boolean"
        }
      }
    }
  }
}
